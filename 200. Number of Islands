LAND = "1"
WATER = "0"

class Solution:
    def numIslands(self, grid: List[List[str]]) -> int:
        height = len(grid)
        width = len(grid[0])

        def in_grid(row, col):
            return 0 <= row < height and 0 <= col < width
        
        def traverse_island(start_row, start_col):
            lands_to_visit = deque()
            lands_to_visit.append((start_row, start_col))
            while lands_to_visit:
                row, col = lands_to_visit.popleft()
                directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]
                for dr, dc in directions:
                    new_row, new_col = row + dr, col + dc
                    if not in_grid(new_row, new_col):
                        continue
                    if grid[new_row][new_col] == WATER:
                        continue
                    if visited[new_row][new_col]:
                        continue
                    visited[new_row][new_col] = True
                    lands_to_visit.append((new_row, new_col))
        
        visited = [[False] * width for _ in range(height)]
        num_islands = 0
        for row in range(height):
            for col in range(width):
                if grid[row][col] == LAND and not visited[row][col]:
                    visited[row][col] = True
                    traverse_island(row, col)
                    num_islands += 1
        return num_islands
```

- ちょっとBFSで詰まった。なぜ以下のコードがTime limit exceededになるか理解ができなかった。時計算量に最大の入力を代入した時間計算量は問題ないと思う。
- 最低でもO(2mn)で、m = n = 300、Pythonが1秒間に10^6ステップを実行できると仮定すると、だいたい0.18秒ぐらいのはず。
- おそらく原因は、どのタイミングで訪れたかを記録すること。動くBFSは隣接した陸をチェックした時に記録する。反対に動かない方は、dequeから取り出した時に記録する。この違いによって、大きな差は生まれないと思う。
- dequeのpopleft処理は関係なさそう。なぜなら、動くバージョンの方もpopleft処理も、同じかそれ以上の回数使っているから。


